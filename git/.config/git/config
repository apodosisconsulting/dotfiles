[core]
	excludesfile = ~/.config/git/ignore
	editor = nvim
[user]
	name = Richard Armstrong
	email = richard@apodosis.co.uk
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[pull]
	# Rebase local commits onto what was fetched instead of merging it, so a
	# pull on a branch that has moved does not add a merge commit.
	rebase = true
[rebase]
	# Pairs with pull.rebase above: without it a `git pull` with anything dirty
	# in the tree aborts with "cannot rebase: you have unstaged changes".
	autoStash = true
[fetch]
	# Drop remote-tracking refs whose branch is gone from the remote. Also what
	# keeps `make tidy`'s merged-branch report honest.
	prune = true
[push]
	# First push of a new branch sets its upstream instead of failing with the
	# "--set-upstream" hint.
	autoSetupRemote = true
[branch]
	# Most recently worked on first, rather than alphabetical.
	sort = -committerdate
[commit]
	# Put the diff in the commit message buffer, so what you describe is what
	# you actually staged.
	verbose = true
[rerere]
	# Record how each conflict was resolved and resolve an identical hunk the
	# same way next time: a rebase redone after --abort, or one fix carried to
	# another branch. The replayed result is written to the file but not
	# staged, so it still gets looked at: rerere.autoUpdate defaults to false.
	enabled = true
[diff]
	# Anchor the diff on lines that occur rarely in both versions, not on the
	# shortest edit. Myers, the default, matches stray braces and blank lines,
	# so one function replaced by another further up read as both rewritten
	# line by line and interleaved; histogram shows one added whole and the
	# other removed whole.
	algorithm = histogram
[merge]
	# Conflicts also show the common ancestor (after |||||||), so what each
	# side changed can be read off rather than guessed. zdiff3 rather than
	# diff3: lines both sides agree on at either end of a conflict are moved
	# out of it.
	conflictstyle = zdiff3
